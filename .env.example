# Switch server (same values as the .env that `just up` writes in the Switch repo)
SWITCH_URL=http://127.0.0.1:8000
GATEWAY_ADMIN_EMAIL=admin@example.com
GATEWAY_ADMIN_PASSWORD=change-me

# Optional language model (every agent has a deterministic fallback)
LLM_BACKEND=none            # none | opencode | openai
# OPENCODE_MODEL=opencode/big-pickle
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=
# LLM_MODEL=gemini-2.0-flash

# Scout posts its list once a day at this hour (IST)
SCOUT_HOUR_IST=9
